<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Workouts</title>
</head>
<body>

    <h1>All Workouts!</h1>
    <a href="/workouts/new">Add new Workout</a>

    <hr>

    <% workouts.forEach((workout) => { %>
        <li>
            <a href="/workouts/<%= workout._id %>">
             <%= workout.name %>
            </a>
        </li>

    <% }) %>



</body>
</html>
